// arduino_secrets.h.example  --  template
//
// Copy this file to  arduino_secrets.h  and fill in your own values.
// arduino_secrets.h is gitignored so your credentials never get committed.
#pragma once

// Wi-Fi network the Matrix Portal joins.
#define SECRET_SSID  "YOUR_WIFI_SSID"
#define SECRET_PASS  "YOUR_WIFI_PASSWORD"

// Web-UI login accounts: { {"user","pass"}, ... }  (max 8).
// SECRET_NUM_USERS must match how many pairs you list.
#define SECRET_ACCOUNTS { { "admin", "changeme" }, { "user", "changeme" } }
#define SECRET_NUM_USERS 2
